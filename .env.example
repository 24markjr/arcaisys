# Copy to .env.local for local development; set the same variables in your host's
# dashboard for production (see docs/deployment.md). Never commit real values.

# Public URL of the site, no trailing slash. Used for canonical URLs, the sitemap and
# social images. Production: https://arcaisys.com — locally: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to "true" in Production only at launch. Until then every page is noindex and
# robots.txt asks crawlers to stay out.
SITE_INDEXABLE=

# --- Contact form email delivery (Resend — https://resend.com) ----------------
# Server-only: never prefix these with NEXT_PUBLIC_.
# Until all three are set, the form tells visitors it is not connected yet
# and does NOT pretend to have sent their message.

# API key from resend.com → API Keys (needs "Sending access").
RESEND_API_KEY=

# Where enquiries are delivered. Comma-separate multiple addresses.
CONTACT_TO_EMAIL=pm.teams@arcaisys.com

# Sender address. Must be on a domain verified in Resend, e.g.
# "Arcaisys Website <website@arcaisys.com>". Before verification only
# "Arcaisys Website <onboarding@resend.dev>" works, and only to the account owner's email.
CONTACT_FROM_EMAIL=
