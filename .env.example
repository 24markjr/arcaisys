# Copy to .env.local for local development; set the same variables in your host's
# dashboard for production. Never commit real values.

# Public URL of the deployed site, no trailing slash. Used for canonical URLs and
# metadata. Domain not yet confirmed — see docs/content-inventory.md.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Contact form email delivery (Resend — https://resend.com) ----------------
# Server-only: never prefix these with NEXT_PUBLIC_.
# Until all three are set, the form tells visitors it is not connected yet
# and does NOT pretend to have sent their message.

# API key from resend.com → API Keys (needs "Sending access").
RESEND_API_KEY=

# Where enquiries are delivered. Comma-separate multiple addresses.
CONTACT_TO_EMAIL=

# Sender address. Must be on a domain verified in Resend (add the DNS records it
# gives you), e.g. "Arcaisys Website <website@arcaisys.com>".
CONTACT_FROM_EMAIL=
