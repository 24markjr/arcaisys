{
  "name": "arcaisys-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "content:audit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/content-audit.mjs",
    "qa:screens": "node scripts/screenshot.mjs",
    "test:form": "node scripts/test-contact-form.mjs",
    "audit:browser": "node scripts/audit/browser-audit.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "check:secrets": "node scripts/check-secrets.mjs --all"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lucide-react": "^1.57.0",
    "next": "16.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.14.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9"
  }
}
